{
  "name": "digital-library-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run-browser-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:reduced-motion": "node scripts/run-browser-tests.mjs --reduced-motion",
    "test:runner": "node --test scripts/browser-test-results.test.mjs scripts/browser-test-coverage.test.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/router": "20.3.34",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "20.3.34",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "axe-core": "^4.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jasmine-core": "~5.7.0",
    "typescript": "~5.9.3",
    "v8-to-istanbul": "^9.3.0"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "@angular/build": {
      "vite": "7.3.7"
    }
  }
}
